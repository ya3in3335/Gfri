<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Read NFC cards. -->
    <uses-permission android:name="android.permission.NFC" />
    <!-- Local network WebSocket to the Green Access Bridge (no Internet services are used). -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Detect Wi-Fi loss/return to reconnect automatically. -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Optional haptic feedback on scan. -->
    <uses-permission android:name="android.permission.VIBRATE" />

    <!-- NFC is the purpose of the app; the app still degrades gracefully ("NFC not available") if sideloaded on a phone without it. -->
    <uses-feature
        android:name="android.hardware.nfc"
        android:required="true"
        tools:ignore="UnnecessaryRequiredFeature" />

    <application
        android:name=".GreenAccesseApp"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="false"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:supportsRtl="true"
        android:theme="@style/Theme.GreenAccesse"
        tools:targetApi="36">

        <activity
            android:name=".presentation.MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
